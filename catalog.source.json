{
  "schema_version": 1,
  "repository": "chazu/mu-plugins",
  "release_tag": "catalog-v0.2.0",
  "plugins": [
    {
      "name": "docker",
      "version": "0.1.0",
      "description": "Docker image builder",
      "entrypoint": "plugin.bb",
      "toolchain": "bb",
      "requirements": ["docker"]
    },
    {
      "name": "doppler",
      "version": "0.1.0",
      "description": "Read-only Doppler secret provider",
      "entrypoint": "plugin.bb",
      "toolchain": "bb",
      "requirements": ["doppler"]
    },
    {
      "name": "file",
      "version": "0.2.0",
      "description": "File convergence with sealed-output capture",
      "entrypoint": "plugin",
      "requirements": ["go >= 1.26"],
      "build": {"command": ["go", "build", "-trimpath", "-o", "plugin", "."], "sources": ["main.go", "go.mod", "go.sum"]}
    },
    {
      "name": "go",
      "version": "0.1.0",
      "description": "Go build toolchain",
      "entrypoint": "plugin.bb",
      "toolchain": "bb",
      "requirements": ["go"]
    },
    {
      "name": "k8s",
      "version": "0.4.0",
      "description": "Kubernetes apply and Secret capture",
      "entrypoint": "plugin.bb",
      "toolchain": "bb",
      "requirements": ["kubectl"]
    },
    {
      "name": "keypair-gen",
      "version": "0.1.0",
      "description": "Ed25519 and ECDSA keypair generator",
      "entrypoint": "plugin",
      "requirements": ["go >= 1.26"],
      "build": {"command": ["go", "build", "-trimpath", "-o", "plugin", "."], "sources": ["main.go", "go.mod", "go.sum"]}
    },
    {
      "name": "lint",
      "version": "0.2.0",
      "description": "Linter wrapper",
      "entrypoint": "plugin.bb",
      "toolchain": "bb"
    },
    {
      "name": "pass",
      "version": "0.3.0",
      "description": "Bidirectional pass secret provider",
      "entrypoint": "plugin",
      "requirements": ["go >= 1.26", "pass"],
      "build": {"command": ["go", "build", "-trimpath", "-o", "plugin", "."], "sources": ["main.go", "go.mod", "go.sum"]}
    },
    {
      "name": "remote-exec",
      "version": "0.2.0",
      "description": "Remote SSH command execution",
      "entrypoint": "plugin",
      "requirements": ["go >= 1.26", "ssh"],
      "build": {"command": ["go", "build", "-trimpath", "-o", "plugin", "."], "sources": ["main.go", "go.mod", "go.sum", "internal/ssh/ssh.go"]}
    },
    {
      "name": "remote-file",
      "version": "0.2.0",
      "description": "Remote file convergence over SSH",
      "entrypoint": "plugin",
      "requirements": ["go >= 1.26", "ssh"],
      "build": {"command": ["go", "build", "-trimpath", "-o", "plugin", "."], "sources": ["main.go", "go.mod", "go.sum", "internal/ssh/ssh.go"]}
    },
    {
      "name": "sops",
      "version": "0.1.0",
      "description": "Bidirectional SOPS secret provider",
      "entrypoint": "plugin.bb",
      "toolchain": "bb",
      "requirements": ["sops"]
    },
    {
      "name": "terraform",
      "version": "0.3.0",
      "description": "Terraform plan, apply, and sensitive-output capture",
      "entrypoint": "plugin.bb",
      "toolchain": "bb",
      "requirements": ["terraform"]
    }
  ]
}
